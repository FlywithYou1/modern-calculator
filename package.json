{
  "name": "modern-calculator",
  "version": "2.0.0",
  "description": "现代化跨平台科学计算器 - 基于 Tauri + TypeScript + Rust",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,md}\"",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
  "test:mcp": "vitest run --config vitest.mcp.config.ts",
  "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
  "test:rust:precision": "cargo test --manifest-path src-tauri/Cargo.toml --features precision-tests",
    "test:cross-platform": "node scripts/test-cross-platform.js",
    "benchmark": "node scripts/benchmark.js",
    "a11y-test": "node scripts/a11y-test.js",
    "typecheck": "tsc --noEmit",
    "quality:check": "npm run typecheck && npm run lint && npm run test:run && npm run build",
    "build:all-platforms": "npm run build && npm run tauri:build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "clean": "rimraf dist coverage src-tauri/target src-tauri/gen/android/app/build"
  },
  "keywords": [
    "calculator",
    "scientific",
    "tauri",
    "typescript",
    "rust",
    "cross-platform",
    "high-precision",
    "modern-ui"
  ],
  "author": "Scientific Calculator Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.6.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "rimraf": "^5.0.7"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "decimal.js": "^10.6.0"
  }
}
