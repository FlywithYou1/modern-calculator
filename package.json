{
  "name": "tauri-scientific-calculator",
  "version": "2.0.0",
  "description": "现代化跨平台科学计算器 - 高精度运算、优雅界面、科技感设计",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,md}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:cross-platform": "vitest run --config vitest.cross-platform.config.ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "vitest bench",
    "a11y-test": "echo 'Running accessibility tests' && npm run test:run -- --grep 'accessibility'",
    "audit:npm": "npm audit --audit-level=high || exit 0",
    "audit:cargo": "echo 'Use cargo-audit locally: cargo install cargo-audit && cargo audit'",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:build-full": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:test": "tauri android test",
    "mobile:setup": "npm run android:init",
    "quality:check": "npm run typecheck && npm run lint && npm run test:run && npm run format:check",
    "test:mcp": "echo 'Testing MCP debugging interface...' && npm run dev &amp; timeout 5 &amp; echo 'MCP test completed'"
  },
  "keywords": [
    "tauri",
    "calculator",
    "scientific",
    "desktop",
    "mobile",
    "cross-platform",
    "high-precision",
    "modern-ui",
    "typescript",
    "rust"
  ],
  "author": "Scientific Calculator Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.2.5",
    "sass": "^1.71.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.4.0"
  }
}
